{
  "manifest_version": 3,
  "name": "A/B Spy",
  "version": "0.1.0",
  "description": "See the A/B tests a website is running right now: every version of the headline, button and page, including the ones you aren't shown.",
  "minimum_chrome_version": "111",
  "action": {
    "default_title": "A/B Spy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["detector.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
